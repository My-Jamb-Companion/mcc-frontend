{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./apps/learner/*",
        "./apps/admin/*"
      ],
      "@mcc/ui": [
        "./packages/ui"
      ],
      "@mcc/ui/*": [
        "./packages/ui/*"
      ],
      "@mcc/features": [
        "./packages/features"
      ],
      "@mcc/features/*": [
        "./packages/features/*"
      ],
      "@mcc/store": [
        "./packages/store"
      ],
      "@mcc/store/*": [
        "./packages/store/*"
      ],
      "@mcc/api": [
        "./packages/api"
      ],
      "@mcc/api/*": [
        "./packages/api/*"
      ],
      "@mcc/tooling/*": [
        "./tooling/*"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    ".next"
  ]
}