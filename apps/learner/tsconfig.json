{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@mcc/ui": [
        "../../packages/ui"
      ],
      "@mcc/api": [
        "../../packages/api"
      ],
      "@mcc/utils": [
        "../../packages/utils"
      ],
      "@mcc/features/*": [
        "../../packages/features/*"
      ],
      "@mcc/features": [
        "../../packages/features"
      ],
      "@mcc/config": [
        "../../packages/config"
      ],
      "@mcc/hooks": [
        "../../packages/hooks"
      ],
      "@mcc/types": [
        "../../packages/types"
      ],
      "@mcc/tooling/*": [
        "../../tooling/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "out"
  ]
}